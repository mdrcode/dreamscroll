# These examples use the full TaskRun payload expected by the handlers.

POST http://localhost:8080/_wh/cloudtask/illuminate HTTP/1.1
Content-Type: application/json

{
    "user_id": 1,
    "logical_id": "u1-illuminate-capture538",
    "run_id": "b91a7c4f-7e8a-4bf8-9a76-c81e258ec113",
    "run_number": 1,
    "task": {
        "capture_id": 538
    }
}

###
POST http://localhost:8080/_wh/cloudtask/spark HTTP/1.1
Content-Type: application/json

{
    "user_id": 1,
    "logical_id": "u1-spark-spark1",
    "run_id": "70f3372f-a395-4d4d-9022-0485684ace5a",
    "run_number": 1,
    "task": {
        "spark_id": 1,
        "capture_ids": [532, 533, 534, 535, 536, 537, 538]
    }
}


<article id="capture-metadata-{{ capture.id }}"
    class="feed-card feed-card--capture capture-card metadata-card"
    {% if oob | default(value=false) %}hx-swap-oob="outerHTML"{% endif %}>
    <div class="capture-card__body">
        <div id="capture-metadata-content-{{ capture.id }}" class="metadata-card__content capture-card__details-panel" inert>
        {% if capture.illuminations | length > 0 %}
        {% set illum = capture.illuminations | first %}

        {% if illum.knowledge_entities | length > 0 %}
        <p class="metadata-subsection-title">Entities</p>
        <dl class="metadata-dict-list">
            {% for entity in illum.knowledge_entities %}
            <dt>
                <a class="pill" href="/entity/{{ entity.id }}"{% if entity.description %} title="{{ entity.description }}"{% endif %}>
                    <span class="pill__prefix">{{ entity.type }}</span>
                    <span class="pill__label">{{ entity.name }}{% if entity.platform_link %} · {{ entity.platform_link.platform }}{% endif %}</span>
                </a>
            </dt>
            {% if entity.description %}
            <dd>{{ entity.description }}</dd>
            {% endif %}
            {% if entity.platform_link %}
            <dd>{% if entity.platform_link.display_name %}{{ entity.platform_link.display_name }} {% endif %}({{ entity.platform_link.handle }})</dd>
            {% endif %}
            {% if entity.search_query %}
            <dd><a href="https://www.google.com/search?q={{ entity.search_query | urlencode }}" target="_blank" rel="noopener noreferrer">Canonical search: {{ entity.search_query }}</a></dd>
            {% endif %}
            {% endfor %}
        </dl>
        {% endif %}

        {% if illum.suggested_searches | length > 0 %}
        <p class="metadata-subsection-title">Related Searches</p>
        <div class="pill-group pill-group--wrap pill-group--queries pill-group--stack">
            {% for query in illum.suggested_searches %}
            <a href="https://www.google.com/search?q={{ query | urlencode }}" target="_blank" rel="noopener noreferrer" class="pill">
                <span class="pill__prefix">⌕</span>
                <span class="pill__label">{{ query }}</span>
            </a>
            {% endfor %}
        </div>
        {% endif %}

        {% endif %}
        </div>

        <div class="capture-card__details-toggle-row metadata-card__toggle-row">
            <button type="button"
                class="capture-card__details-toggle metadata-card__toggle"
                aria-expanded="false"
                aria-controls="capture-metadata-content-{{ capture.id }}">More</button>
        </div>
    </div>
</article>

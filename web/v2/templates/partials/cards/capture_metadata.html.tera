<section id="capture-metadata-{{ capture.id }}"
    class="capture-metadata"
    {% if oob | default(value=false) %}hx-swap-oob="outerHTML"{% endif %}>
    {% if capture.illuminations | length > 0 %}
    {% set illum = capture.illuminations | first %}

    {% if illum.observed_entities | length > 0 %}
    <p class="metadata-subsection-title">Entities</p>
    <div class="pill-group pill-group--wrap capture-metadata__links">
        {% for entity in illum.observed_entities %}
        <a class="pill" href="/entity/{{ entity.id }}"{% if entity.description %} title="{{ entity.description }}"{% endif %}>
            <span class="pill__prefix">{{ entity.type }}</span>
            <span class="pill__label">{{ entity.name }}</span>
        </a>
        {% endfor %}
    </div>
    {% endif %}

    {% if illum.suggested_searches | length > 0 %}
    <p class="metadata-subsection-title">Related Searches</p>
    <div class="pill-group pill-group--wrap">
        {% for query in illum.suggested_searches %}
        <a href="https://www.google.com/search?q={{ query | urlencode }}" target="_blank" rel="noopener noreferrer" class="pill pill--search" title="Search: {{ query }}">
            <span class="pill__prefix pill__prefix--icon">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.35-4.35"></path></svg>
            </span>
            <span class="pill__label">{{ query }}</span>
        </a>
        {% endfor %}
    </div>
    {% endif %}
    {% endif %}
</section>

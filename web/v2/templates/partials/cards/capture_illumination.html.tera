<div id="capture-illumination-{{ capture.id }}"
    class="capture-card__illumination{% if animate_illumination %} is-revealing{% endif %}"
    data-snapshot-at="{{ page_snapshot_at }}"
    data-has-illumination="{% if capture.illuminations | length > 0 %}true{% else %}false{% endif %}">
    {% if capture.illuminations | length > 0 %}
    {% set illum = capture.illuminations | first %}
    {% set has_details = illum.details %}

    {% if illum.summary %}
    <p class="capture-card__summary">{{ illum.summary }}</p>
    {% endif %}

    {% if has_details %}
    <div class="capture-card__details-toggle-row">
        <button type="button"
            class="capture-card__details-toggle"
            aria-expanded="false"
            aria-controls="capture-details-{{ capture.id }}">More</button>
    </div>

    <div id="capture-details-{{ capture.id }}" class="capture-card__details-panel" inert>
        <div class="capture-card__details-wrap">
            <p class="capture-card__details">{{ illum.details }}</p>
        </div>
    </div>
    {% endif %}

    {% if illum.knowledge_entities | length > 0 %}
    <div class="pill-group pill-group--scroll pill-group--entities pill-group--stack">
        {% for entity in illum.knowledge_entities %}
        <span class="pill"{% if entity.description %} title="{{ entity.description }}"{% endif %}>
            <span class="pill__prefix">{{ entity.type }}</span>
            <span class="pill__label">{{ entity.name }}{% if entity.platform_link %} · {{ entity.platform_link.platform }}{% endif %}</span>
        </span>
        {% endfor %}
    </div>
    {% endif %}

    {% if illum.suggested_searches | length > 0 %}
    <div class="pill-group pill-group--scroll pill-group--queries pill-group--stack">
        {% for query in illum.suggested_searches %}
        <a href="https://www.google.com/search?q={{ query | urlencode }}" target="_blank" rel="noopener noreferrer" class="pill">
            <span class="pill__prefix">⌕</span>
            <span class="pill__label">{{ query }}</span>
        </a>
        {% endfor %}
    </div>
    {% endif %}
    {% endif %}
</div>

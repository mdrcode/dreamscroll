<form class="card-footer__archive-form"
    method="post"
    action="{% if capture.archived_at %}/capture/{{ capture.id }}/unarchive{% else %}/capture/{{ capture.id }}/archive{% endif %}">
    <input type="hidden" name="next" value="{{ archive_return_to }}">
    <button type="submit" class="card-footer__action">{% if capture.archived_at %}unarchive{% else %}archive{% endif %}</button>
</form>

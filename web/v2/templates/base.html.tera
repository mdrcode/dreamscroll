<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1a1917">
    <title>{% block title %}dreamscroll{% endblock %}</title>
    <link rel="manifest" href="/manifest.webmanifest?v={{ static_asset_version | urlencode }}">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png?v={{ static_asset_version | urlencode }}">
    <link rel="stylesheet" href="/static/dreamscroll-v2.css?v={{ static_asset_version | urlencode }}">
    {% block head %}{% endblock %}
    {% block scripts %}
    <script defer src="https://unpkg.com/htmx.org@2.0.11" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
    <script defer src="/static/webui-v2.js?v={{ static_asset_version | urlencode }}"></script>
    {% endblock %}
</head>

<body data-page-kind="{{ page_kind }}"{% block body_attrs %}{% endblock %}>
    <div id="page-content-container">
        {% block header %}{% include "partials/header.html.tera" %}{% endblock %}

        {% block content %}{% endblock %}
    </div>
</body>

</html>

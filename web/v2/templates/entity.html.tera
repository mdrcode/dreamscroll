{% extends "base.html.tera" %}

{% block title %}dreamscroll - {% if entity.knowledge_entity %}{{ entity.knowledge_entity.name }}{% else %}{{ entity.name }}{% endif %}{% endblock %}

{% block content %}
{% if entity.knowledge_entity %}
{#- Warm: the shared entity is the subject; the observation is its evidence. -#}
{% set ke = entity.knowledge_entity %}
<article class="feed-card entity-card" aria-labelledby="entity-name">
    <header class="entity-card__header">
        <h2 id="entity-name" class="entity-card__name">{{ ke.name }} <span class="entity-card__type">[{{ ke.entity_type }}]</span></h2>
    </header>

    <div class="entity-card__body">
        {% if descriptions | length == 1 %}
        <p class="entity-card__description">{{ descriptions[0] }}</p>
        {% elif descriptions | length > 1 %}
        <ul class="entity-card__descriptions">
            {% for description in descriptions %}
            <li>{{ description }}</li>
            {% endfor %}
        </ul>
        {% endif %}

        {% if ke.search_query or entity.search_query or ke.platform or entity.platform_link or ke.identities | length > 0 or ke.alt_names | length > 0 %}
        {% set query = ke.search_query | default(value=entity.search_query) %}
        <div class="pill-group pill-group--wrap entity-card__links">
            {% if query %}
            <a class="pill pill--search" href="https://www.google.com/search?q={{ query | urlencode }}" target="_blank" rel="noopener noreferrer" title="Canonical search: {{ query }}">
                <span class="pill__prefix pill__prefix--icon">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.35-4.35"></path></svg>
                </span>
                <span class="pill__label">{{ query }}</span>
            </a>
            {% endif %}
            {% if ke.platform %}
            <span class="pill">
                <span class="pill__prefix">{{ ke.platform }}</span>
                <span class="pill__label">{{ ke.platform_handle }}{% if ke.platform_display_name %} · {{ ke.platform_display_name }}{% endif %}</span>
            </span>
            {% elif entity.platform_link %}
            <span class="pill">
                <span class="pill__prefix">{{ entity.platform_link.platform }}</span>
                <span class="pill__label">{{ entity.platform_link.handle }}</span>
            </span>
            {% endif %}
            {% for identity in ke.identities %}
            {% if identity.scheme == "wikidata" %}
            <a class="pill" href="https://www.wikidata.org/wiki/{{ identity.external_id }}"
                target="_blank" rel="noopener noreferrer"
                {% if identity.method %}title="{{ identity.method }} · {{ identity.provider }}"{% endif %}>
                <span class="pill__prefix">{{ identity.scheme }}</span>
                <span class="pill__label">{{ identity.external_id }}</span>
            </a>
            {% else %}
            <span class="pill"
                {% if identity.method %}title="{{ identity.method }} · {{ identity.provider }}"{% endif %}>
                <span class="pill__prefix">{{ identity.scheme }}</span>
                <span class="pill__label">{{ identity.external_id }}</span>
            </span>
            {% endif %}
            {% endfor %}
            {% for name in ke.alt_names %}
            <span class="pill">
                <span class="pill__prefix">also</span>
                <span class="pill__label">{{ name }}</span>
            </span>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <footer class="card-footer">
        <span class="card-timestamp">#{{ entity.id }} · {{ capture.created_at_human }}</span>
    </footer>
</article>
{% else %}
{#- Cold: illuminated, not yet linked. The reading stands on its own; the page is honest about
    the gap, and a refresh picks up the linked view. -#}
<article class="feed-card entity-card" aria-labelledby="entity-name">
    <header class="entity-card__header">
        <p class="metadata-subsection-title">Entity occurrence</p>
        <h2 id="entity-name" class="entity-card__name">{{ entity.name }} <span class="entity-card__type">[{{ entity.type }}]</span></h2>
    </header>

    <div class="entity-card__body">
        {% if entity.description %}
        <p class="entity-card__description">{{ entity.description }}</p>
        {% endif %}

        {% if entity.search_query or entity.platform_link %}
        <div class="pill-group pill-group--wrap entity-card__links">
            {% if entity.search_query %}
            <a class="pill pill--search" href="https://www.google.com/search?q={{ entity.search_query | urlencode }}" target="_blank" rel="noopener noreferrer" title="Canonical search: {{ entity.search_query }}">
                <span class="pill__prefix pill__prefix--icon">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.35-4.35"></path></svg>
                </span>
                <span class="pill__label">{{ entity.search_query }}</span>
            </a>
            {% endif %}
            {% if entity.platform_link %}
            <span class="pill">
                <span class="pill__prefix">{{ entity.platform_link.platform }}</span>
                <span class="pill__label">{{ entity.platform_link.handle }}</span>
            </span>
            {% endif %}
        </div>
        {% endif %}

        <p class="entity-card__muted" role="status">
            Not linked to the graph yet. Refresh once linking finishes.
        </p>

    </div>

    <footer class="card-footer">
        <span class="card-timestamp">#{{ entity.id }} · {{ capture.created_at_human }}</span>
    </footer>
</article>
{% endif %}

{% if siblings | length > 0 or co_occurrences | length > 0 %}
<section class="entity-section" aria-labelledby="entity-siblings-title">
    <p id="entity-siblings-title" class="metadata-subsection-title">Occurs With</p>
    <div class="pill-group pill-group--wrap">
        {% for sibling in siblings %}
        <a class="pill" href="/entity/{{ sibling.id }}"{% if sibling.description %} title="{{ sibling.description }}"{% endif %}>
            <span class="pill__prefix">{{ sibling.type }}</span>
            <span class="pill__label">{{ sibling.name }}</span>
        </a>
        {% endfor %}
        {% for related in co_occurrences %}
        <a class="pill" href="/entity/{{ related.id }}"{% if related.description %} title="{{ related.description }}"{% endif %}>
            {% if related.knowledge_entity %}
            <span class="pill__prefix">{{ related.knowledge_entity.entity_type }}</span>
            <span class="pill__label">{{ related.knowledge_entity.name }}</span>
            {% else %}
            <span class="pill__prefix">{{ related.type }}</span>
            <span class="pill__label">{{ related.name }}</span>
            {% endif %}
        </a>
        {% endfor %}
    </div>
</section>
{% endif %}

<section class="entity-section" aria-labelledby="entity-source-title">
    <p id="entity-source-title" class="metadata-subsection-title">Appears in</p>
    {% if entity.knowledge_entity %}
    <div class="related-captures__grid" aria-label="Related capture gallery">
        {% for occurrence in occurrences %}
        <a class="related-captures__item" href="/capture/{{ occurrence.id }}" title="{{ occurrence.summary }} · {{ occurrence.created_at_human }}" aria-label="{{ occurrence.summary }}"{% if occurrence.observation_id == entity.id %} aria-current="page"{% endif %}>
            <img src="{{ occurrence.thumbnail_url }}" alt="capture {{ occurrence.id }}" loading="lazy">
        </a>
        {% endfor %}
    </div>
    {% else %}
    <a href="/capture/{{ capture.id }}" class="capture-preview-item" title="Capture {{ capture.id }}">
        <div class="capture-preview-thumb">
            {% if capture.medias | length > 0 %}
            <img src="{{ capture.medias[0].url }}" alt="capture {{ capture.id }}">
            {% endif %}
        </div>
        <div class="capture-preview-meta">
            <p class="capture-preview-meta-summary">
                {% if capture.illuminations | length > 0 %}
                {{ capture.illuminations[0].summary }}
                {% else %}
                Open capture {{ capture.id }}
                {% endif %}
            </p>
        </div>
    </a>
    {% endif %}
</section>
{% endblock %}
